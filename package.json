{
  "name": "aibankingportal",
  "version": "1.0.0",
  "private": false,
  "description": "A secure, accessible Canadian retail banking portal demo",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/store.js && node --check public/js/api.js",
